POSTGRES_USER=user
POSTGRES_PASSWORD=userpss
POSTGRES_DB=transcendence
DATABASE_URL=postgres://user:userpss@pgdb:5432/transcendence

FRONTEND_PORT=3000
BACKEND_PORT=3001

# Ports nginx listens on and publishes on the host (HTTP only redirects to HTTPS).
# Change them here only: compose, nginx and the URLs below all read these.
HTTP_PORT=8000
HTTPS_PORT=8001

# Baked into the frontend at build time; the browser calls these, so use localhost.
NEXT_PUBLIC_API_URL=https://localhost:${HTTPS_PORT}/api
NEXT_PUBLIC_WS_URL=wss://localhost:${HTTPS_PORT}

# Used only by Next.js during server rendering inside Docker: HTTPS through nginx.
# Informational: docker-compose.yml sets this value for the frontend.
INTERNAL_API_URL=https://nginx:${HTTPS_PORT}/api

# JWT secret used to sign authentication tokens
# Generate a secure value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT token expiration time in seconds
JWT_EXPIRES_IN=9000

# Refresh session lifetime (7 days) and public path exposed by nginx
REFRESH_TOKEN_EXPIRES_IN=604800
REFRESH_COOKIE_PATH=/api/auth

#Upload directory
UPLOAD_DIR=/app/uploads

# Optional: tldraw licence key (removes the "made with tldraw" watermark).
# Read by the browser, so it is baked in at build time: rebuild the frontend
# image after changing it. Leave unset to run with the watermark.
TLDRAW_API_KEY=tldraw-2027-02-15/WyJBdVNtbGltayIsWyIqIl0sMTYsIjIwMjctMDItMTUiXQ.YXu+0auLOOTGykLuBmvm68vAvirM8n2krTBmqmX5NPksLSNdskBFNZbmKq9JTgSXZq1eVx5CBiTGCpe4Fup0ug
