POSTGRES_USER=user
POSTGRES_PASSWORD=userpss
POSTGRES_DB=transcendence
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@pgdb:5432/${POSTGRES_DB}

FRONTEND_PORT=3000
BACKEND_PORT=3001

# Baked into the frontend at build time; the browser calls these, so use localhost.
NEXT_PUBLIC_API_URL=http://localhost:${BACKEND_PORT}
NEXT_PUBLIC_WS_URL=ws://localhost:${BACKEND_PORT}

#Upload directory
UPLOAD_DIR=/app/uploads
