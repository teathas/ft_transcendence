POSTGRES_USER=user
POSTGRES_PASSWORD=userpss
POSTGRES_DB=transcendence
DATABASE_URL=postgres://user:userpss@pgdb:5432/transcendence

FRONTEND_PORT=3000
BACKEND_PORT=3001

# Baked into the frontend at build time; the browser calls these, so use localhost.
NEXT_PUBLIC_API_URL=https://localhost/api
NEXT_PUBLIC_WS_URL=wss://localhost

# Used only by Next.js during server rendering inside Docker.
INTERNAL_API_URL=http://backend:3001

# JWT secret used to sign authentication tokens
# Generate a secure value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT token expiration time in seconds
JWT_EXPIRES_IN=900

# Refresh session lifetime (7 days) and public path exposed by nginx
REFRESH_TOKEN_EXPIRES_IN=604800
REFRESH_COOKIE_PATH=/api/auth

#Upload directory
UPLOAD_DIR=/app/uploads

# Optional: tldraw licence key (removes the "made with tldraw" watermark).
# Read by the browser, so it is baked in at build time: rebuild the frontend
# image after changing it. Leave unset to run with the watermark.
TLDRAW_API_KEY=
