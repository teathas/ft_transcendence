POSTGRES_USER=user
POSTGRES_PASSWORD=userpss
POSTGRES_DB=transcendence
DATABASE_URL=postgres://user:userpss@pgdb:5432/transcendence

# The only port opened on the host. The app and the API stay on the internal
# network behind nginx, which is why there is no CORS anywhere in this project.
PROXY_PORT=8080

# Ports the services listen on inside the network. They are never published;
# nginx picks them up through its config template, so changing them here is
# enough.
FRONTEND_PORT=3000
BACKEND_PORT=3001

# Path the refresh cookie is scoped to, as the browser sees it — nginx serves
# the API under /api, so the cookie must say so too.
REFRESH_COOKIE_PATH=/api/auth/refresh
REFRESH_EXPIRES_IN_DAYS=30

# Set to true the moment the app is served over HTTPS. Left false locally
# because a Secure cookie over plain http is dropped by every browser except
# on localhost.
REFRESH_COOKIE_SECURE=false

# Baked into the frontend at build time. Relative, because nginx serves the API
# on the same origin.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# JWT secret used to sign authentication tokens
# Generate a secure value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT token expiration time in seconds
JWT_EXPIRES_IN=900

#Upload directory
UPLOAD_DIR=/app/uploads
