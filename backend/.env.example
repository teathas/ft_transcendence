# Frontend URL used by the backend for CORS configuration
FRONTEND_URL=http://localhost:3000

# Port used by the NestJS backend
PORT=3001

# PostgreSQL database connection string
# Replace the values with your local PostgreSQL credentials/database
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# JWT secret used to sign authentication tokens
# Generate a secure value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# JWT token expiration time in seconds
JWT_EXPIRES_IN=900

# Refresh session lifetime in seconds and browser cookie path
REFRESH_TOKEN_EXPIRES_IN=604800
REFRESH_COOKIE_PATH=/api/auth
