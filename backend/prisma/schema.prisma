// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum Visibility {
  PUBLIC
  PRIVATE
}

model Room {
  id         String     @id @default(uuid())
  name       String
  subject    String
  visibility Visibility @default(PUBLIC)
  inviteCode String     @unique

  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id])
  members   RoomMember[]
  createdAt DateTime     @default(now())
}

model User {
  id              String       @id @default(uuid())
  email           String       @unique
  username        String       @unique
  passwordHash    String
  avatarUrl       String?
  bio             String?
  status          UserStatus   @default(OFFLINE)
  lastSeenAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  rooms           Room[]
  refreshTokens   RefreshToken[]
  roomMemberships RoomMember[]
}

enum UserStatus {
  ONLINE
  OFFLINE
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model RoomMember {
  userId   String
  roomId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])

  @@id([userId, roomId])
}

/// One row per issued refresh token. The token itself is never stored, only a
/// SHA-256 digest, so a database leak cannot be replayed against the API.
model RefreshToken {
  id        String    @id @default(uuid())
  /// SHA-256 of the opaque token handed to the browser.
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Set when the token is rotated or revoked; a presented-but-revoked token
  /// means the cookie leaked, which revokes the whole family.
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
